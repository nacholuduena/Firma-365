# Configuración de Base de Datos DQD
# SQL Server connection
DQD_SERVER=localhost
DQD_DATABASE=DQD
DQD_USERNAME=sa
DQD_PASSWORD=your_password_here
DQD_DRIVER=ODBC Driver 17 for SQL Server
DQD_PORT=1433

# Modo demo (usa datos simulados si no hay conexión a DQD)
DEMO_MODE=true

# Servidor
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
